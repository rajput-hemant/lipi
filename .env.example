# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty to enable schema validation; any nonempty value skips that check.
# Separate production DB/auth guards bypass only on the exact value true.
SKIP_ENV_VALIDATION=

# -----------------------------------------------------------------------------
# Realtime (standalone process; see docs/realtime.md)
# -----------------------------------------------------------------------------
# Development defaults to ws://localhost:1234. Set your wss:// URL in production.
NEXT_PUBLIC_LIPI_REALTIME_URL=
LIPI_REALTIME_PORT=1234
LIPI_REALTIME_ADDRESS=127.0.0.1
# Development defaults to http://localhost:3000,http://127.0.0.1:3000.
# Production requires an explicit list of exact Lipi browser origins.
LIPI_REALTIME_ALLOWED_ORIGINS=
# The app and realtime process need the same DATABASE_URL and auth secret.
# Next.js loads .env.local; the standalone Node process needs exported variables
# or an explicit env file: node --env-file=.env.local realtime/bootstrap.mjs.

# -----------------------------------------------------------------------------
# UploadThing (optional locally; token required for binary uploads)
# -----------------------------------------------------------------------------
UPLOADTHING_TOKEN=
# Legacy variables remain optional in lib/env.ts and do not replace the token.
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

#-----------------------------------------------------------------------------------------------
# Better Auth
#-----------------------------------------------------------------------------------------------
# openssl rand -base64 32
#-----------------------------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

#-----------------------------------------------------------------------------------------------
# Google Credentials
#-----------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#-----------------------------------------------------------------------------------------------
# Github Credentials
#-----------------------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

#-----------------------------------------------------------------------------------------------
# Database
#-----------------------------------------------------------------------------------------------
DATABASE_URL=

#-----------------------------------------------------------------------------------------------
# Upstash Redis (https://console.upstash.com)
#-----------------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENABLE_RATE_LIMITING=false
RATE_LIMITING_REQUESTS_PER_SECOND=20

#-----------------------------------------------------------------------------------------------
# Stripe (billing; optional at build, required at runtime for checkout/webhooks)
#-----------------------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
