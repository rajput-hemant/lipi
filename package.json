{
  "name": "lipi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun next dev --turbopack",
    "build": "bun next build",
    "start": "bun next start",
    "preview": "bun next build && bun next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test --workers=1",
    "realtime:dev": "node --watch realtime/bootstrap.mjs",
    "realtime:start": "node realtime/bootstrap.mjs",
    "fmt": "prettier --write \"**/*.{ts,tsx,mdx,json}\" --cache",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,mdx,json}\" --cache",
    "db:generate": "drizzle-kit generate",
    "db:setup": "bun run db:auth && bun run db:migrate && bun run db:seed",
    "db:auth": "drizzle-kit migrate --config drizzle.auth.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun lib/db/seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:drop": "drizzle-kit drop",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "ui": "bunx shadcn-ui",
    "clean": "rm -rf .next",
    "cleani": "rm -rf .next && rm -rf node_modules && bun i",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/shadcn": "^0.55.0",
    "@hocuspocus/extension-database": "4.7.0",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@uploadthing/react": "7.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-df7b47d-20241124",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "emoji-picker-react": "^4.22.2",
    "jiti": "^2.7.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "7.7.4",
    "uuid": "^14.0.2",
    "valtio": "^2.3.2",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "^19.0.0-beta-df7b47d-20241124",
    "happy-dom": "20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": [
      "prettier --write"
    ],
    "*.{ts,tsx,mdx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/helpers": "7.29.7",
    "@humanfs/node": "0.16.8",
    "babel-plugin-react-compiler": "19.0.0-beta-df7b47d-20241124",
    "browserslist": "4.29.3",
    "cross-spawn": "7.0.6",
    "effect": "3.22.2",
    "eslint-plugin-react-compiler": "19.0.0-beta-df7b47d-20241124",
    "flatted": "3.4.4",
    "js-yaml": "4.3.2",
    "micromatch": "4.0.8",
    "zod-validation-error": "4.0.2"
  }
}
