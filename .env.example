# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=false

# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET=local-development-secret-must-be-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-development-secret-must-be-at-least-32-chars-long

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/local_platforms

# Redis
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=localdevtoken

# Rate limiting
ENABLE_RATE_LIMITING=false
RATE_LIMITING_REQUESTS_PER_SECOND=20
TRUSTED_PROXY_COUNT=0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# UploadThing
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Realtime
NEXT_PUBLIC_LIPI_REALTIME_URL=ws://localhost:1234
LIPI_REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LIPI_REALTIME_PORT=1234
LIPI_REALTIME_ADDRESS=127.0.0.1
